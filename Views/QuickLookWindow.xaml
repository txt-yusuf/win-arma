<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" x:Class="WinArma.Views.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hızlı Önizleme (Quick Look)" 
        Height="500" 
        Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Outer Container with Shadow -->
    <Grid Margin="15">
        <Border x:Name="QuickLookBorder"
                CornerRadius="14"
                Background="#181922"
                BorderBrush="#2E3040"
                BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Color="#000000"
                                  Opacity="0.55"
                                  ShadowDepth="8"
                                  Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Preview Content -->
                    <RowDefinition Height="Auto"/> <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid Grid.Row="0" Margin="18,14,14,12" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="7"
                            Background="#222433"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                        <Grid>
                            <Image x:Name="FileIconImage"
                                   Width="24"
                                   Height="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="FileIconSymbol"
                                       Text="📄"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Title and File Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="FileNameText"
                                   Text="Dosya Adı"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FileMetaText"
                                   Text="Boyut • Değiştirilme Tarihi"
                                   FontSize="11.5"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="2"
                            Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="0" Height="1" Background="#242635" VerticalAlignment="Bottom"/>

                <!-- Content: Dynamically shows Image, Text, or Info Cards -->
                <Grid Grid.Row="1" Margin="16,12">
                    <!-- Image Preview View -->
                    <Border x:Name="ImageViewerBorder"
                            Background="#111218"
                            CornerRadius="8"
                            Padding="8"
                            Visibility="Collapsed">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Text / Code Preview View -->
                    <Border x:Name="TextViewerBorder"
                            Background="#111218"
                            BorderBrush="#252735"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="PreviewTextBox"
                                     Background="Transparent"
                                     Foreground="#E5E7EB"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     FontFamily="Cascadia Code, Consolas, Courier New"
                                     FontSize="12.5"
                                     TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>

                    <!-- General Info Card View -->
                    <Border x:Name="InfoViewerBorder"
                            Background="#111218"
                            BorderBrush="#252735"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="InfoTitleText" Text="Dosya Bilgisi" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="InfoPathText" Text="C:\Yol..." FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,14" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
                            <Border Background="#1C1E2A" CornerRadius="6" Padding="12,8" HorizontalAlignment="Center">
                                <TextBlock x:Name="InfoDetailsText" Text="Tür: Dosya • Boyut: 0 KB" FontSize="11.5" Foreground="#60A5FA"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer Bar -->
                <Border Grid.Row="2"
                        Background="#13141B"
                        BorderBrush="#242635"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14"
                        Padding="16,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="[Enter] Dosyayı Aç" FontSize="11" Foreground="#6B7280" Margin="0,0,12,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="#4B5563" Margin="0,0,12,0"/>
                            <TextBlock Text="[Ctrl+Enter] Klasörde Göster" FontSize="11" Foreground="#6B7280" Margin="0,0,12,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="#4B5563" Margin="0,0,12,0"/>
                            <TextBlock Text="[Esc / Boşluk] Kapat" FontSize="11" Foreground="#6B7280"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Klasörde Göster"
                                    Background="#252736"
                                    Foreground="#D1D5DB"
                                    BorderThickness="0"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Cursor="Hand"
                                    Margin="0,0,8,0"
                                    Click="RevealButton_Click"/>
                            <Button Content="Dosyayı Aç"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Padding="12,4"
                                    FontSize="11.5"
                                    Cursor="Hand"
                                    Click="OpenButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
