<Window UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" x:Class="WinArma.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Win-Arma Ayarları" 
        Height="630" 
        Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Custom CheckBox Style -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="TemplateRoot"
                    Background="#252736"
                    BorderBrush="#3A3D52"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chevron Arrow -->
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="#9CA3AF"
                          StrokeThickness="1.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#60A5FA"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#3B82F6"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#31354A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full Dark Modern ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- Toggle Button (Combobox surface) -->
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <!-- Selected Item Display Text -->
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <!-- Dropdown Popup -->
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="220">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E202D"
                                            BorderBrush="#3A3D52"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18"
                                                              Color="#000000"
                                                              Opacity="0.6"
                                                              ShadowDepth="6"
                                                              Direction="270"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snippet editor: text boxes -->
        <Style x:Key="SnippetTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#252736"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="CaretBrush" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#3A3D52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Snippet editor: flat buttons -->
        <Style x:Key="SnippetFlatButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2C2E40"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Key / value editor row shared by snippets and quick commands -->
        <DataTemplate x:Key="PairRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource SnippetTextBox}"
                         VerticalAlignment="Top"
                         Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Column="1"
                         Style="{StaticResource SnippetTextBox}"
                         Margin="8,0,0,0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="96"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2"
                        Style="{StaticResource SnippetFlatButton}"
                        Content="✕"
                        ToolTip="Sil"
                        Width="28"
                        Height="28"
                        Margin="6,0,0,0"
                        VerticalAlignment="Top"
                        Click="DeleteRow_Click"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Dialog Border with Shadow -->
    <Grid Margin="15">
        <Border CornerRadius="14"
                Background="#181922"
                BorderBrush="#2C2E40"
                BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25"
                                  Color="#000000"
                                  Opacity="0.5"
                                  ShadowDepth="8"
                                  Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="*"/>    <!-- Scrollable Content -->
                    <RowDefinition Height="Auto"/> <!-- Action Footer -->
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Grid Grid.Row="0" Margin="20,16,16,14" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Win-Arma Ayarları" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button Grid.Column="1"
                            Content="✕"
                            Width="28"
                            Height="28"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            FontSize="13"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#EF4444"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Border Grid.Row="0" Height="1" Background="#242635" VerticalAlignment="Bottom"/>

                <!-- Content Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,14">
                    <StackPanel>

                        <!-- Section: Genel & Kısayol -->
                        <TextBlock Text="GENEL &amp; KISAYOL" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Açma Kısayol Tuşu" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Uygulama penceresini çağıran küresel kısayol" Foreground="#9CA3AF" FontSize="11"/>
                                    </StackPanel>
                                    <ComboBox x:Name="HotkeyCombo" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Alt + Space" Tag="Alt"/>
                                        <ComboBoxItem Content="Ctrl + Space" Tag="Ctrl"/>
                                        <ComboBoxItem Content="Win + Space" Tag="Win"/>
                                        <ComboBoxItem Content="Ctrl + Alt + Space" Tag="Ctrl+Alt"/>
                                        <ComboBoxItem Content="Alt + Shift + Space" Tag="Alt+Shift"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Background="#282A3A" Margin="0,6"/>

                                <CheckBox x:Name="StartupCheckBox" Content="Windows başladığında otomatik çalıştır" Margin="0,6,0,2"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Web & Arama Motoru -->
                        <TextBlock Text="WEB VE ARAMA MOTORU" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Varsayılan Arama Motoru" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Web aramaları için kullanılacak motor" Foreground="#9CA3AF" FontSize="11"/>
                                </StackPanel>
                                <ComboBox x:Name="SearchEngineCombo" Grid.Column="1" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Google"/>
                                    <ComboBoxItem Content="Bing"/>
                                    <ComboBoxItem Content="DuckDuckGo"/>
                                    <ComboBoxItem Content="Yandex"/>
                                    <ComboBoxItem Content="Brave"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Section: Arama Kapsamı -->
                        <TextBlock Text="ARAMA KAPSAMI (MODÜLLER)" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="AppSearchCheckBox" Content="Yüklü Uygulamalar (.lnk, Başlat Menüsü, Ayarlar)"/>
                                <CheckBox x:Name="FileSearchCheckBox" Content="Dosya ve Klasörler (Windows Search &amp; Yerel Dizinler)"/>
                                <CheckBox x:Name="WebSearchCheckBox" Content="Web Araması ve Hızlı Linkler (g, y, gh, w önekleri)"/>
                                <CheckBox x:Name="CalcCheckBox" Content="Canlı Hesap Makinesi (Matematik ifadeleri, panoya kopyalama)"/>
                                <CheckBox x:Name="SysCmdCheckBox" Content="Sistem Komutları (Kilitle, Kapat, Yeniden Başlat, Çöpü Boşalt)"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Gelişmiş Üretkenlik Araçları -->
                        <TextBlock Text="GELİŞMİŞ ÜRETKENLİK ARAÇLARI" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ClipboardCheckBox" Content="📋 Pano Geçmişi ('pano' veya 'cb' ile son 50 kopyalanan metin)"/>
                                <CheckBox x:Name="QuickLookCheckBox" Content="👀 Dosya Hızlı Önizleme (macOS Quick Look - Shift+Boşluk ile)"/>
                                <CheckBox x:Name="SnippetsCheckBox" Content="⚡ Metin Kısayolları ('!mail', '!iban', '!tarih', '!tel' şablonları)"/>
                                <CheckBox x:Name="WindowSearchCheckBox" Content="🪟 Açık Pencereler ('pencere' yazın ya da başlığını arayın)"/>
                                <CheckBox x:Name="UpdateCheckBox" Content="🔔 Yeni sürüm bildirimi (GitHub'dan yalnızca son sürüm numarası sorulur)"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Metin Kısayolları -->
                        <TextBlock Text="METİN KISAYOLLARI" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,10"
                                           Text="Arama kutusuna kısayolu yazıp Enter'a basınca içerik panoya kopyalanır. Kısayollar ! ile başlar. Yerleşik !tarih, !saat, !bugun ve !guid değiştirilemez."/>

                                <ItemsControl x:Name="SnippetList" ItemTemplate="{StaticResource PairRowTemplate}"/>

                                <TextBlock x:Name="SnippetErrorText" Foreground="#F87171" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Visibility="Collapsed"/>

                                <Button Style="{StaticResource SnippetFlatButton}"
                                        Content="＋ Yeni kısayol ekle"
                                        Foreground="#60A5FA"
                                        HorizontalAlignment="Left"
                                        Padding="8,5"
                                        FontSize="12"
                                        Click="AddSnippet_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Hızlı Komutlar -->
                        <TextBlock Text="HIZLI KOMUTLAR" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#9CA3AF" FontSize="11" Margin="0,2,0,10"
                                           Text="Bir sözcüğü yazıp Enter'a basınca web adresi, klasör, dosya ya da program açılır. Örnek: yt → https://www.youtube.com, proje → D:\Projeler. %USERPROFILE% gibi ortam değişkenleri kullanılabilir."/>

                                <ItemsControl x:Name="CommandList" ItemTemplate="{StaticResource PairRowTemplate}"/>

                                <TextBlock x:Name="CommandErrorText" Foreground="#F87171" FontSize="11" TextWrapping="Wrap"
                                           Margin="0,0,0,6" Visibility="Collapsed"/>

                                <Button Style="{StaticResource SnippetFlatButton}"
                                        Content="＋ Yeni komut ekle"
                                        Foreground="#60A5FA"
                                        HorizontalAlignment="Left"
                                        Padding="8,5"
                                        FontSize="12"
                                        Click="AddCommand_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Görünüm & Davranış -->
                        <TextBlock Text="GÖRÜNÜM &amp; DENEYİM" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,8"/>
                        <Border Background="#202230" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2C2E40" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Maksimum Sonuç Sayısı" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Listede tek seferde gösterilecek kayıt sayısı" Foreground="#9CA3AF" FontSize="11"/>
                                    </StackPanel>
                                    <ComboBox x:Name="MaxResultsCombo" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBoxItem Content="6 Sonuç" Tag="6"/>
                                        <ComboBoxItem Content="8 Sonuç (Önerilen)" Tag="8"/>
                                        <ComboBoxItem Content="10 Sonuç" Tag="10"/>
                                        <ComboBoxItem Content="12 Sonuç" Tag="12"/>
                                        <ComboBoxItem Content="15 Sonuç" Tag="15"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Background="#282A3A" Margin="0,6"/>

                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Görsel Tema" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Arama arayüzünün renk paleti" Foreground="#9CA3AF" FontSize="11"/>
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Açık / Beyaz Tema (Light)" Tag="Light"/>
                                        <ComboBoxItem Content="Koyu Grafit (Dark)" Tag="Dark"/>
                                        <ComboBoxItem Content="Gece Mavisi (Midnight)" Tag="Midnight"/>
                                        <ComboBoxItem Content="Derin Siyah (Amoled)" Tag="Amoled"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Action Footer -->
                <Border Grid.Row="2"
                        Background="#13141B"
                        BorderBrush="#242635"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,14,14"
                        Padding="18,12">
                    <Grid>
                        <!-- Reset to defaults button -->
                        <Button Content="Varsayılanlara Sıfırla"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Foreground="#9CA3AF"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"
                                Click="ResetDefaultsButton_Click"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="İptal"
                                    Width="80"
                                    Height="32"
                                    Background="#252736"
                                    Foreground="#D1D5DB"
                                    BorderThickness="0"
                                    Margin="0,0,10,0"
                                    Cursor="Hand"
                                    Click="CloseButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Kaydet ve Uygula"
                                    Width="130"
                                    Height="32"
                                    Background="#2563EB"
                                    Foreground="#FFFFFF"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="SaveButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="saveBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="saveBorder" Property="Background" Value="#1D4ED8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
